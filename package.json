{
  "name": "@ai-testing-tool/atlassian-adf-lite",
  "version": "0.1.3",
  "description": "Typed builders, validator and serializers for the Atlassian Document Format (ADF)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && printf '%s\\n' '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "release": "sh scripts/publish.sh",
    "release:dry": "DRY_RUN=true sh scripts/publish.sh"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ai-testing-tool/atlassian-adf-lite.git"
  },
  "homepage": "https://github.com/ai-testing-tool/atlassian-adf-lite#readme",
  "bugs": {
    "url": "https://github.com/ai-testing-tool/atlassian-adf-lite/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "atlassian",
    "adf",
    "jira",
    "confluence"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "5.4"
  }
}
